---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const koPosts = (await getCollection('postsKo')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const enPosts = await getCollection('postsEn');
const enSlugs = new Set(enPosts.map((p) => p.id));

function readingTime(text: string): number {
  const stripped = text
    .replace(/```[\s\S]*?```/g, '')
    .replace(/`[^`]*`/g, '')
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/[#*_~>\-+|]/g, '')
    .trim();
  return Math.max(1, Math.round(stripped.length / 500));
}

const siteName = "Gihun's brain";
const siteDescription =
  "Lee Gihun (이기훈)의 글 모음. 원래 ML 하다가 지금은 7명짜리 제품 팀 리딩 중. AI, 팀, 매니저 일 같은 거 쓴다.";

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: 'https://lee-gihun.github.io/',
  description: siteDescription,
  inLanguage: 'ko',
  author: {
    '@type': 'Person',
    name: 'Lee Gihun',
    alternateName: '이기훈',
    sameAs: ['https://github.com/Lee-Gihun'],
  },
};
---
<BaseLayout
  title={siteName}
  description={siteDescription}
  type="website"
  lang="ko"
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />

  <header class="site-header">
    <h1>{siteName}</h1>
    <p class="tagline">
      여기는 생각 dump가 모이는 곳. 원래 ML 하다가 지금은 7명짜리 제품 팀 리딩 중. AI, 팀, 매니저 일 같은 거 쓴다.
    </p>
    <p class="lang-switch"><a href="/en/">English →</a></p>
  </header>

  <main>
    <ul class="post-list">
      {
        koPosts.map((post) => {
          const date = post.data.pubDate.toISOString().split('T')[0];
          const mins = readingTime(post.body ?? '');
          const hasEn = enSlugs.has(post.id);
          return (
            <li>
              <h2 class="post-list-title">
                <a href={`/posts/${post.id}/`}>{post.data.title}</a>
              </h2>
              <p class="post-list-meta">
                <time datetime={date}>{date}</time>
                <span class="sep">·</span>
                <span>{mins} min read</span>
                {hasEn && (
                  <>
                    <span class="sep">·</span>
                    <a href={`/en/posts/${post.id}/`}>EN</a>
                  </>
                )}
              </p>
              <p class="post-list-description">{post.data.description}</p>
            </li>
          );
        })
      }
    </ul>
  </main>

  <footer class="site">
    <p>
      © 2026 Lee Gihun (이기훈)
      <span class="sep">·</span>
      <a href="https://github.com/Lee-Gihun">GitHub</a>
      <span class="sep">·</span>
      <a href="/llms.txt">llms.txt</a>
      <span class="sep">·</span>
      <a href="/sitemap-index.xml">Sitemap</a>
    </p>
  </footer>
</BaseLayout>
