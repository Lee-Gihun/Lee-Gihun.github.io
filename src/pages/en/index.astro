---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const enPosts = (await getCollection('postsEn')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const koPosts = await getCollection('postsKo');
const koSlugs = new Set(koPosts.map((p) => p.id));

const siteName = "Gihun's brain";
const siteDescription =
  "Lee Gihun — ML researcher background, currently leading a 7-person cross-functional product team. Writing on AI, team building, decision-making, and leadership.";

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: 'https://lee-gihun.github.io/en/',
  description: siteDescription,
  inLanguage: 'en',
  author: {
    '@type': 'Person',
    name: 'Lee Gihun',
    alternateName: '이기훈',
    sameAs: ['https://github.com/Lee-Gihun'],
  },
};
---
<BaseLayout
  title={siteName}
  description={siteDescription}
  type="website"
  lang="en"
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />

  <header>
    <h1>{siteName}</h1>
    <p>A space for thinking out loud.</p>
    <p class="lang-switch">
      <a href="/">한국어 →</a>
    </p>
  </header>

  <main>
    <ul class="post-list">
      {
        enPosts.map((post) => {
          const date = post.data.pubDate.toISOString().split('T')[0];
          const hasKo = koSlugs.has(post.id);
          return (
            <li>
              <a href={`/en/posts/${post.id}/`}>{post.data.title}</a>
              <p class="meta" style="margin-top: 0.25rem; margin-bottom: 0;">
                <time datetime={date}>{date}</time>
                {hasKo && (
                  <>
                    <span class="sep">·</span>
                    <a href={`/posts/${post.id}/`}>KO</a>
                  </>
                )}
              </p>
            </li>
          );
        })
      }
    </ul>
  </main>
</BaseLayout>
