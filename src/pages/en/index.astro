---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const enPosts = (await getCollection('postsEn')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const koPosts = await getCollection('postsKo');
const koSlugs = new Set(koPosts.map((p) => p.id));

function readingTime(text: string): number {
  const stripped = text
    .replace(/```[\s\S]*?```/g, '')
    .replace(/`[^`]*`/g, '')
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/[#*_~>\-+|]/g, '')
    .trim();
  const words = stripped.split(/\s+/).filter((w) => w.length > 0).length;
  return Math.max(1, Math.round(words / 220));
}

const siteName = "Gihun's brain";
const siteDescription =
  "Lee Gihun. ML researcher background, currently leading a 7-person cross-functional product team. Writing on AI, team building, and decision-making.";

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: 'https://lee-gihun.github.io/en/',
  description: siteDescription,
  inLanguage: 'en',
  author: {
    '@type': 'Person',
    name: 'Lee Gihun',
    alternateName: '이기훈',
    sameAs: ['https://github.com/Lee-Gihun'],
  },
};
---
<BaseLayout
  title={siteName}
  description={siteDescription}
  type="website"
  lang="en"
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />

  <header class="site-header">
    <h1>{siteName}</h1>
    <p class="tagline">
      A space for thinking out loud. ML researcher background, currently leading
      a 7-person cross-functional product team. Notes on AI, team building, and
      decision-making.
    </p>
    <p class="lang-switch"><a href="/">한국어 →</a></p>
  </header>

  <main>
    <ul class="post-list">
      {
        enPosts.map((post) => {
          const date = post.data.pubDate.toISOString().split('T')[0];
          const mins = readingTime(post.body ?? '');
          const hasKo = koSlugs.has(post.id);
          return (
            <li>
              <h2 class="post-list-title">
                <a href={`/en/posts/${post.id}/`}>{post.data.title}</a>
              </h2>
              <p class="post-list-meta">
                <time datetime={date}>{date}</time>
                <span class="sep">·</span>
                <span>{mins} min read</span>
                {hasKo && (
                  <>
                    <span class="sep">·</span>
                    <a href={`/posts/${post.id}/`}>KO</a>
                  </>
                )}
              </p>
              <p class="post-list-description">{post.data.description}</p>
            </li>
          );
        })
      }
    </ul>
  </main>

  <footer class="site">
    <p>
      © 2026 Lee Gihun
      <span class="sep">·</span>
      <a href="https://github.com/Lee-Gihun">GitHub</a>
      <span class="sep">·</span>
      <a href="/llms.txt">llms.txt</a>
      <span class="sep">·</span>
      <a href="/sitemap-index.xml">Sitemap</a>
    </p>
  </footer>
</BaseLayout>
