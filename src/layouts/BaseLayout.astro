---
interface Translation {
  url: string;
  lang: 'ko' | 'en';
}

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  lang?: 'ko' | 'en';
  markdownPath?: string;
  translation?: Translation;
}

const {
  title,
  description,
  type = 'website',
  pubDate,
  lang = 'ko',
  markdownPath,
  translation,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const siteName = "Gihun's brain";
const author = 'Lee Gihun';
const ogLocale = lang === 'en' ? 'en_US' : 'ko_KR';
const ogLocaleAlternate = lang === 'en' ? 'ko_KR' : 'en_US';
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c1917" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={ogLocale} />
    {translation && (
      <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    )}
    {pubDate && (
      <meta property="article:published_time" content={pubDate.toISOString()} />
    )}
    {pubDate && <meta property="article:author" content={author} />}

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {translation && (
      <link rel="alternate" hreflang={translation.lang} href={translation.url} />
    )}
    {translation && (
      <link rel="alternate" hreflang={lang} href={canonicalURL} />
    )}

    <link rel="sitemap" href="/sitemap-index.xml" />
    {markdownPath && (
      <link rel="alternate" type="text/markdown" href={markdownPath} />
    )}

    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;

    --bg: #fbfaf7;
    --surface: #f4f3ee;
    --text: #1c1917;
    --text-heading: #0c0a09;
    --text-muted: #57534e;
    --text-subtle: #78716c;
    --link: #1d4ed8;
    --link-hover: #1e3a8a;
    --border: #e7e5e4;
    --border-strong: #d6d3d1;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #1c1917;
      --surface: #292524;
      --text: #e7e5e4;
      --text-heading: #fafaf9;
      --text-muted: #a8a29e;
      --text-subtle: #78716c;
      --link: #93c5fd;
      --link-hover: #bfdbfe;
      --border: #292524;
      --border-strong: #44403c;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    font-family:
      'Pretendard Variable', Pretendard, -apple-system, BlinkMacSystemFont,
      system-ui, Roboto, 'Helvetica Neue', 'Segoe UI', 'Apple SD Gothic Neo',
      'Noto Sans KR', 'Malgun Gothic', 'Apple Color Emoji', 'Segoe UI Emoji',
      'Segoe UI Symbol', sans-serif;
    font-size: 17px;
    line-height: 1.75;
    letter-spacing: -0.011em;
    -webkit-text-size-adjust: 100%;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  @media (max-width: 540px) {
    html {
      font-size: 16px;
    }
  }

  body {
    max-width: 40rem;
    margin: 0 auto;
    padding: 4rem 1.5rem 5rem;
    color: var(--text);
    background: var(--bg);
    word-break: keep-all;
    overflow-wrap: anywhere;
  }

  @media (max-width: 540px) {
    body {
      padding: 2.5rem 1.25rem 3rem;
    }
  }

  h1,
  h2,
  h3,
  h4 {
    color: var(--text-heading);
    letter-spacing: -0.02em;
  }

  h1 {
    font-size: 1.875rem;
    line-height: 1.3;
    margin: 0 0 0.5rem;
    font-weight: 700;
  }

  h2 {
    font-size: 1.3rem;
    line-height: 1.5;
    margin: 3rem 0 1rem;
    font-weight: 600;
  }

  h3 {
    font-size: 1.1rem;
    margin: 2rem 0 0.75rem;
    font-weight: 600;
  }

  p,
  ul,
  ol {
    margin: 1.25rem 0;
  }

  article p {
    margin: 1.1rem 0;
  }

  a {
    color: var(--link);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition:
      color 0.15s ease,
      text-decoration-thickness 0.15s ease;
  }

  a:hover {
    color: var(--link-hover);
    text-decoration-thickness: 2px;
  }

  code {
    font-family:
      ui-monospace, SFMono-Regular, 'SF Mono', Menlo, 'Cascadia Mono',
      'Roboto Mono', monospace;
    font-size: 0.92em;
    background: var(--surface);
    padding: 0.15em 0.4em;
    border-radius: 4px;
    border: 1px solid var(--border);
  }

  hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: 3rem 0;
  }

  blockquote {
    border-left: 3px solid var(--border-strong);
    margin: 1.5rem 0;
    padding: 0.5rem 0 0.5rem 1.5rem;
    color: var(--text-muted);
  }

  .meta {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 0 0 2.5rem;
  }

  .meta .sep,
  nav.top .sep {
    margin: 0 0.55em;
    color: var(--border-strong);
  }

  nav.top {
    margin: 0 0 3rem;
    font-size: 0.9rem;
  }

  nav.top a {
    color: var(--text-muted);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 1px;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  nav.top a:hover {
    color: var(--text-heading);
    border-bottom-color: var(--text-heading);
  }

  .site-header {
    margin: 0 0 3rem;
  }

  .site-header h1 {
    font-size: 1.6rem;
    margin: 0 0 0.6rem;
    letter-spacing: -0.025em;
  }

  .site-header .tagline-lead {
    color: var(--text);
    font-size: 1.08rem;
    font-weight: 500;
    margin: 0.6rem 0 0;
    line-height: 1.55;
    letter-spacing: -0.012em;
  }

  .site-header .tagline {
    color: var(--text-muted);
    font-size: 0.98rem;
    margin: 1rem 0 0;
    line-height: 1.7;
  }

  .lang-switch {
    font-size: 0.875rem;
    margin: 1.25rem 0 0;
  }

  .lang-switch a {
    color: var(--text-muted);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .lang-switch a:hover {
    color: var(--text-heading);
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .post-list li {
    padding: 1.75rem 0;
    border-top: 1px solid var(--border);
  }

  .post-list li:last-child {
    border-bottom: 1px solid var(--border);
  }

  .post-list-title {
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.4;
    margin: 0 0 0.4rem;
  }

  .post-list-title a {
    color: var(--text-heading);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 1px;
    transition: border-color 0.15s ease;
  }

  .post-list-title a:hover {
    border-bottom-color: var(--text-heading);
  }

  .post-list-meta {
    color: var(--text-muted);
    font-size: 0.85rem;
    margin: 0 0 0.6rem;
  }

  .post-list-meta a {
    color: var(--text-muted);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .post-list-meta a:hover {
    color: var(--text-heading);
  }

  .post-list-description {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin: 0;
    line-height: 1.7;
  }

  article header {
    margin: 0 0 2.5rem;
  }

  article header h1 {
    font-size: 1.95rem;
    margin: 0 0 0.6rem;
    letter-spacing: -0.025em;
    line-height: 1.25;
  }

  @media (max-width: 540px) {
    article header h1 {
      font-size: 1.55rem;
    }
  }

  footer.post {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  footer.post a {
    color: var(--text-muted);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  footer.post a:hover {
    color: var(--text-heading);
  }

  footer.site {
    margin-top: 5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.85rem;
    line-height: 1.75;
  }

  footer.site a {
    color: var(--text-muted);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  footer.site a:hover {
    color: var(--text-heading);
  }

  ::selection {
    background: var(--border-strong);
    color: var(--text-heading);
  }
</style>
