---
import BaseLayout from './BaseLayout.astro';

interface Translation {
  title: string;
  url: string;
  lang: 'ko' | 'en';
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  lang: 'ko' | 'en';
  postUrl: string;
  markdownUrl: string;
  readingTime: number;
  translation?: Translation;
}

const {
  title,
  description,
  pubDate,
  lang,
  postUrl,
  markdownUrl,
  readingTime,
  translation,
} = Astro.props;

const formattedDate = pubDate.toISOString().split('T')[0];
const homeUrl = lang === 'en' ? '/en/' : '/';
const homeLabel = lang === 'en' ? "← Gihun's brain" : "← Gihun's brain";
const toggleLabel =
  translation && (translation.lang === 'en' ? 'Read in English →' : '한국어로 읽기 →');
const minReadLabel = lang === 'en' ? 'min read' : 'min read';

const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  inLanguage: lang === 'en' ? 'en' : 'ko',
  datePublished: pubDate.toISOString(),
  dateModified: pubDate.toISOString(),
  author: {
    '@type': 'Person',
    name: 'Lee Gihun',
    alternateName: '이기훈',
    url: 'https://lee-gihun.github.io/',
    sameAs: ['https://github.com/Lee-Gihun'],
  },
  publisher: {
    '@type': 'Person',
    name: 'Lee Gihun',
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': postUrl,
  },
  url: postUrl,
};

if (translation) {
  jsonLd.alternativeHeadline = translation.title;
  jsonLd.workTranslation = {
    '@type': 'CreativeWork',
    headline: translation.title,
    inLanguage: translation.lang,
    url: translation.url,
  };
}
---
<BaseLayout
  title={title}
  description={description}
  type="article"
  pubDate={pubDate}
  lang={lang}
  markdownPath={markdownUrl}
  translation={translation && { url: translation.url, lang: translation.lang }}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />

  <nav class="top">
    <a href={homeUrl}>{homeLabel}</a>
    {translation && (
      <>
        <span class="sep">·</span>
        <a href={translation.url}>{toggleLabel}</a>
      </>
    )}
  </nav>

  <article>
    <header>
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={formattedDate}>{formattedDate}</time>
        <span class="sep">·</span>
        <span>{readingTime} {minReadLabel}</span>
      </p>
    </header>

    <slot />

    <footer class="post">
      <p>
        <a href={markdownUrl}>{lang === 'en' ? 'Markdown version' : 'Markdown 버전'}</a>
        {' · '}
        <a href="/llms.txt">llms.txt</a>
      </p>
    </footer>
  </article>
</BaseLayout>
